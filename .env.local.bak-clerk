NODE_ENV=development
APP_URL=http://localhost:3100
APP_PORT=3000
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice_me?schema=public
BETTER_AUTH_SECRET=dev-secret-key-must-be-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
INTERNAL_PDF_SECRET=dev-pdf-secret-key-at-least-32-chars-long
INTERNAL_APP_URL=http://localhost:3000
PDF_SERVICE_URL=http://localhost:3090
PDF_WORKER_ENABLED=true
STORAGE_ROOT=./.data
UPLOAD_MAX_MB=2
DEFAULT_TIMEZONE=Asia/Jakarta
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=admin123
BANK_ACCOUNT_ENCRYPTION_KEY=dev-encryption-key-must-be-32-chars!

# Origins Better Auth trusts for Origin-checked POSTs (sign-out etc.).
# Tunnel SSH terlihat sebagai http://localhost:3000 di sisi browser.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000
