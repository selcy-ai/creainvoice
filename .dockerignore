# ─── creainvoice Docker ignore ─────────────────────────────────────────────────

# App node_modules are copied directly (npm registry not available inside build)
# pdf-service/node_modules are also copied from host

# Build output (exclude cache but include the standalone output needed by Dockerfile)
.next/*
!.next/standalone
!.next/static
# Warm turbopack/font cache from the host — lets an offline build stage reuse
# fetches (fonts) that already happened; a fresh machine simply rebuilds it.
!.next/cache
out/
build/

# Local dev data
.data/

# Environment secrets — NEVER enter the image. Runtime values come from the
# compose/Coolify environment; the build stage exports its own placeholders.
.env
.env.local
.env.production
.env.*.local

# Version control
.git/
.gitignore

# Test artifacts
test-results/
playwright-report/
coverage/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# TypeScript build info
*.tsbuildinfo

# Kanban
.kanban-cards.json

# Context (not needed in image)
context/
