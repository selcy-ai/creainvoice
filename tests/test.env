# Hermetic test environment — loaded by tests/setup/env.ts.
# DATABASE_URL here ALWAYS wins over the real environment so tests can never
# touch the development database.
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/creainvoice_test
# Change 14: self-hosted better-auth placeholders so src/server/env.ts parses.
BETTER_AUTH_SECRET=test-better-auth-secret-key-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

APP_URL=http://localhost:3000
APP_PORT=3000
INTERNAL_PDF_SECRET=test-pdf-secret-key-must-be-at-least-32-chars
INTERNAL_APP_URL=http://localhost:3000
# The poller is driven explicitly by tests (worker.ts runOnce), never by a timer.
PDF_SERVICE_URL=http://localhost:3001
PDF_WORKER_ENABLED=false
STORAGE_ROOT=./.data-test
UPLOAD_MAX_MB=2
DEFAULT_TIMEZONE=Asia/Jakarta
BANK_ACCOUNT_ENCRYPTION_KEY=test-encryption-key-must-be-32-chars
