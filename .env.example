# ─── creainvoice Environment Variables ────────────────────────────────────────
# Copy this file to .env.local for local development.
# Production values are set in the Vercel dashboard — never commit them.

# ─── Application ─────────────────────────────────────────────────────────────

# Environment mode
NODE_ENV=development

# Public base URL of the app
APP_URL=http://localhost:3000

# Host port mapping (Docker)
APP_PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────

# Neon Postgres connection string (pooled endpoint).
# Local dev AND tests connect to Neon (engineer decision, Change 6).
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXX-pooler.region.aws.neon.tech/creainvoice?sslmode=require

# ─── Authentication (Clerk) ──────────────────────────────────────────────────

# Publishable key — safe for the client bundle (pk_test_… / pk_live_…)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Secret key — server only, NEVER expose to the client (sk_test_… / sk_live_…)
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Where <SignIn /> / <SignUp /> are hosted (Clerk redirects here)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Signing secret for the /api/clerk/webhook sync route (Svix). Generate in the
# Clerk dashboard → Webhooks → endpoint, "Copy signing key".
CLERK_WEBHOOK_SIGNING_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── PDF Service ─────────────────────────────────────────────────────────────

# Shared secret signing requests from the app to pdf-service
INTERNAL_PDF_SECRET=change-me-generate-with-openssl-rand-base64-32

# URL the pdf-service uses to fetch the app's internal print route
INTERNAL_APP_URL=http://localhost:3000

# URL the app uses to reach pdf-service (POST /render)
PDF_SERVICE_URL=http://localhost:3090

# The PdfJob poller runs inside the app process (single instance MVP).
# "false" disables it — used by tests, which drive the worker explicitly.
PDF_WORKER_ENABLED=true

# ─── Storage ─────────────────────────────────────────────────────────────────

# Root of the persistent file storage (uploads + generated invoices)
STORAGE_ROOT=./.data

# Max upload size in MB (logo, signature, PO attachment, payment proof)
UPLOAD_MAX_MB=2

# ─── Localization ────────────────────────────────────────────────────────────

DEFAULT_TIMEZONE=Asia/Jakarta

# ─── Bank account encryption at rest ─────────────────────────────────────────

# AES-256-GCM key material — generate with: openssl rand -base64 32
BANK_ACCOUNT_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ─── Error tracking ──────────────────────────────────────────────────────────

# GlitchTip / Sentry-compatible DSN (optional; empty = disabled)
#GLITCHTIP_DSN=

# ─── Seed (optional) ─────────────────────────────────────────────────────────

# Demo data seed (scripts/seed.mjs). Only runs when DEMO_SEED=1 so production
# never silently gains fixture rows.
DEMO_SEED=0
DEMO_ORG_NAME=CreaInvoice Studio
DEMO_USER_EMAIL=admin@creainvoice.id

# ─── Backup scripts (script-only — not read by the app) ──────────────────────

#BACKUP_DEST=/backups
#BACKUP_RETENTION_DAYS=30
#BACKUP_EXTERNAL_PATH=/mnt/nas/creainvoice-backups
#PG_CONTAINER=creainvoice-postgres-1
#RESTORE_TEST_DATABASE=creainvoice_restore_check
